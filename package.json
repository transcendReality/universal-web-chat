{
  "name": "universal-web-chat",
  "version": "1.0.0",
  "description": "Chat on any website with P2P technology",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "build:chrome": "node scripts/build.js chrome",
    "build:firefox": "node scripts/build.js firefox",
    "build:edge": "node scripts/build.js edge",
    "build:brave": "node scripts/build.js brave",
    "build:all": "node scripts/build.js",
    "dev": "webpack --watch --config webpack/dev.config.js",
    "dev:chrome": "webpack --watch --config webpack/chrome.config.js",
    "generate-manifests": "node scripts/generate-manifests.js",
    "server": "node server/index.js",
    "lint": "eslint src/**/*.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:server": "jest --testPathPattern=server",
    "test:build": "node scripts/test-build.js",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:server",
    "dev:test": "concurrently \"npm run server\" \"npm run dev:chrome\" \"npm run test:e2e:ui\""
  },
  "keywords": [
    "browser-extension",
    "chat",
    "p2p",
    "webrtc"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "mongoose": "^8.17.1",
    "simple-peer": "^9.11.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.6.1",
    "vue": "^3.2.47",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@babel/core": "^7.21.4",
    "@babel/preset-env": "^7.21.4",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/vue": "^8.0.0",
    "@vue/test-utils": "^2.4.3",
    "babel-loader": "^9.1.2",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.3",
    "eslint": "^8.38.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-vue": "^9.10.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "style-loader": "^3.3.2",
    "supertest": "^6.3.3",
    "terser-webpack-plugin": "^5.3.7",
    "vue-loader": "^17.0.1",
    "webpack": "^5.79.0",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.8.0"
  }
}
