{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@server/*": ["server/*"]
    },
    "experimentalDecorators": true,
    "jsx": "preserve"
  },
  "include": [
    "src/**/*",
    "server/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.js"
  ]
}
